generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Peserta {
  id             Int     @id @default(autoincrement())
  nik            String  @unique
  nama           String
  status         Boolean
  departement_id Int?
  location       String?
  entity         String?

  departemnt Departement? @relation(fields: [departement_id], references: [id])
}

model Hadiah {
  id       Int     @id @default(autoincrement())
  nama     String
  no_urut  Int
  pemenang Int?
  img_url  String?
}

model Departement {
  id      Int       @id @default(autoincrement())
  name    String?
  status  Boolean   @default(true)
  Peserta Peserta[]
}
